<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data noupdate="1">
    <!-- Employees see their own advances; HR Officer manages; HR Manager
         approves. The two HR groups are Odoo's own, so no new group is needed
         for them. -->
    <record id="salary_advance_rule_own" model="ir.rule">
      <field name="name">Salary Advance: own records only</field>
      <field name="model_id" ref="model_hr_salary_advance"/>
      <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="salary_advance_rule_hr" model="ir.rule">
      <field name="name">Salary Advance: HR sees all in their companies</field>
      <field name="model_id" ref="model_hr_salary_advance"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="salary_advance_installment_rule_own" model="ir.rule">
      <field name="name">Salary Advance Installment: own records only</field>
      <field name="model_id" ref="model_hr_salary_advance_installment"/>
      <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="salary_advance_installment_rule_hr" model="ir.rule">
      <field name="name">Salary Advance Installment: HR sees all in their companies</field>
      <field name="model_id" ref="model_hr_salary_advance_installment"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
  </data>
</odoo>
