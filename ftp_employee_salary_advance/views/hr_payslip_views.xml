<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_hr_payslip_form_salary_advance" model="ir.ui.view">
    <field name="name">hr.payslip.form.salary.advance</field>
    <field name="model">hr.payslip</field>
    <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
    <field name="arch" type="xml">
      <page name="account_info" position="before">
        <page string="Salary Advance" name="salary_advance"
              invisible="not salary_advance_installment_ids">
          <field name="salary_advance_installment_ids" readonly="1">
            <list>
              <field name="advance_id"/>
              <field name="installment_no"/>
              <field name="installment_date"/>
              <field name="amount"/>
              <field name="already_paid" optional="hide"/>
              <field name="state"/>
              <field name="currency_id" column_invisible="1"/>
            </list>
          </field>
        </page>
      </page>
    </field>
  </record>
</odoo>
