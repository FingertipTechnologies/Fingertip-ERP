<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_payment_reminder" model="ir.ui.view">
        <field name="name">account.move.form.payment.reminder</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="ft_stop_reminder" widget="radio" options="{'horizontal': true}"
                       invisible="move_type != 'out_invoice'"/>
                <field name="ft_reminder_last_date" invisible="move_type != 'out_invoice' or not ft_reminder_last_date"/>
                <field name="ft_reminder_last_status" invisible="move_type != 'out_invoice' or not ft_reminder_last_status"/>
            </field>
        </field>
    </record>
</odoo>
