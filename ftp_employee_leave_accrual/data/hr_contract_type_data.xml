<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data noupdate="1">
    <!-- Intern and Probation already ship with Odoo / l10n_in; Consultant does
         not, so the fourth status in the policy has somewhere to live. -->
    <record id="contract_type_consultant" model="hr.contract.type">
      <field name="name">Consultant</field>
      <field name="sequence">2002</field>
    </record>

    <!-- HR's stage list is Trainee, Probation, Confirmed/Permanent,
         Consultant/Contract, Intern. Intern and Probation already exist;
         these two did not. Neither is eligible for the monthly accrual. -->
    <record id="contract_type_trainee" model="hr.contract.type">
      <field name="name">Trainee</field>
      <field name="sequence">2003</field>
    </record>
  </data>
</odoo>
