<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Variable pay is typed on the payslip (Pay This Month on the Variable
         Pay tab) and paid by these rules. -->

    <!-- Same payout on the stock India structure, for employees whose salary is
         maintained natively rather than imported from greytHR. No greytHR CTC is
         involved, so nothing has to be re-entered for them.

         Sequence 40 sits after the last stock allowance (CAR, 38) and well before
         GROSS (100). This structure has NO reconciliation plug - it is plainly
         GROSS = BASIC + ALW and NET = BASIC + ALW + DED - so an ALW rule flows
         straight into both, and none of the sequence-98 care the greytHR
         structure needs applies here. -->
    <record id="regular_rule_variable_pay" model="hr.salary.rule">
        <field name="code">VAR_PAY</field>
        <field name="name">Performance Variable Pay</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">40</field>
        <field name="struct_id" ref="l10n_in_hr_payroll.hr_payroll_structure_in_employee_salary"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(payslip.ft_variable_pay_amount)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip.ft_variable_pay_amount</field>
    </record>

    <!-- Sequenced 98, immediately BEFORE the gross reconciliation at 99. That
         ordering is load-bearing: GROSS_RECON plugs BASIC + ALW up to
         paid_amount, so an ALW earning it cannot see is silently cancelled out
         and net pay never moves. Running first means this amount is inside
         categories['ALW'] when GROSS_RECON subtracts it back out again. -->
    <record id="greythr_rule_variable_pay" model="hr.salary.rule">
        <field name="code">VAR_PAY</field>
        <field name="name">Performance Variable Pay</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">98</field>
        <field name="struct_id" ref="greythr_structure"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(payslip.ft_variable_pay_amount)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip.ft_variable_pay_amount</field>
    </record>
</odoo>
