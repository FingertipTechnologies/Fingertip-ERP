    <record id="greythr_history_rule_basic" model="hr.salary.rule">
        <field name="name">Basic Salary</field>
        <field name="code">BASIC</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="greythr_history_structure"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'HIST_BASIC' in inputs and inputs['HIST_BASIC'].amount</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs['HIST_BASIC'].amount</field>
    </record>
