<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Payslips paid in greytHR (April - August 2026), held in Odoo with
         greytHR's own amounts so the year-to-date figures and the income tax
         projection built on them are complete. Each statement column is a
         payslip input; the rules below only pay it out, under the same codes
         as the monthly structure. These salaries are already in the
         accounts, so validating never posts a journal entry (see
         models/history.py). -->
    <record id="greythr_history_structure" model="hr.payroll.structure">
        <field name="name">Fingertip: greytHR History</field>
        <field name="code">FT_GREYTHR_HIST</field>
        <field name="country_id" ref="base.in"/>
        <field name="type_id" ref="greythr_structure_type"/>
        <field name="report_id" ref="l10n_in_hr_payroll.action_report_payslip_in"/>
        <field name="use_worked_day_lines" eval="False"/>
        <field name="rule_ids" eval="[]"/>
        <field name="note">greytHR salary statement, as paid. Not recalculated and not posted to accounting.</field>
    </record>
    <record id="input_type_hist_days" model="hr.payslip.input.type">
        <field name="name">History: Days in Month</field>
        <field name="code">HIST_DAYS</field>
        <field name="struct_ids" eval="[(4, ref('greythr_history_structure'))]"/>
    </record>
    <record id="input_type_hist_lop" model="hr.payslip.input.type">
        <field name="name">History: LOP Days</field>
        <field name="code">HIST_LOP</field>
        <field name="struct_ids" eval="[(4, ref('greythr_history_structure'))]"/>
    </record>
    <record id="input_type_hist_effective" model="hr.payslip.input.type">
        <field name="name">History: Effective Workdays</field>
        <field name="code">HIST_EFFECTIVE</field>
        <field name="struct_ids" eval="[(4, ref('greythr_history_structure'))]"/>
    </record>
    <record id="input_type_hist_basic" model="hr.payslip.input.type">
        <field name="name">History: Basic</field>
        <field name="code">HIST_BASIC</field>
        <field name="struct_ids" eval="[(4, ref('greythr_history_structure'))]"/>
    </record>
    <record id="input_type_hist_hra" model="hr.payslip.input.type">
        <field name="name">History: HRA</field>
        <field name="code">HIST_HRA</field>
        <field name="struct_ids" eval="[(4, ref('greythr_history_structure'))]"/>
    </record>
    <record id="input_type_hist_spl" model="hr.payslip.input.type">
