<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="variable_pay_view_list" model="ir.ui.view">
    <field name="name">hr.variable.pay.list</field>
    <field name="model">hr.variable.pay</field>
    <field name="arch" type="xml">
      <list string="Performance Variable Pay" sample="1"
            decoration-muted="state == 'paid'" decoration-info="state == 'draft'">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="department_id" optional="show"/>
        <field name="financial_year_label" string="Financial Year"/>
        <field name="date_start" optional="hide"/>
        <field name="date_end" optional="hide"/>
        <field name="payout_date" optional="show"/>
        <field name="quarterly_target" sum="Target"/>
        <field name="performance_percentage" avg="Avg Performance %" widget="float" digits="[16,2]"/>
        <field name="amount_payable" sum="Payable"/>
        <field name="payslip_id" optional="show"/>
        <field name="state" widget="badge"
               decoration-success="state == 'paid'" decoration-warning="state == 'submitted'"
               decoration-info="state == 'approved'"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="variable_pay_view_form" model="ir.ui.view">
    <field name="name">hr.variable.pay.form</field>
    <field name="model">hr.variable.pay</field>
    <field name="arch" type="xml">
      <form string="Performance Variable Pay">
        <header>
          <button name="action_submit" type="object" string="Submit"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" type="object" string="Approve"
                  class="btn-primary" invisible="state != 'submitted'"
                  groups="hr_payroll.group_hr_payroll_manager"/>
          <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                  invisible="state not in ('submitted', 'approved')"
                  groups="hr_payroll.group_hr_payroll_manager"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <div class="alert alert-info" role="alert" invisible="state != 'approved' or payslip_id">
            Approved and waiting for payroll. The payslip whose period contains
            <field name="payout_date" readonly="1" class="oe_inline"/> will pick this amount up
            automatically as the VAR_PAY other input.
          </div>
          <group>
            <group string="Employee">
              <field name="employee_id" readonly="state != 'draft'"/>
              <field name="version_id" readonly="state != 'draft'"/>
              <field name="department_id"/>
              <field name="company_id" groups="base.group_multi_company"
                     readonly="state != 'draft'"/>
              <field name="currency_id" groups="base.group_multi_company"/>
            </group>
            <group string="Period">
              <field name="financial_year" readonly="state != 'draft'"/>
              <field name="date_start" required="1" readonly="state != 'draft'"/>
              <field name="date_end" required="1" readonly="state != 'draft'"/>
              <field name="payout_date" required="1" readonly="state not in ('draft', 'submitted')"/>
            </group>
            <group string="Performance">
              <field name="quarterly_target" readonly="state not in ('draft', 'submitted')"/>
              <field name="performance_percentage" readonly="state not in ('draft', 'submitted')"/>
              <field name="amount_computed"/>
            </group>
            <group string="Payout">
              <field name="use_override" readonly="state not in ('draft', 'submitted')"/>
              <field name="amount_override" invisible="not use_override"
                     required="use_override" readonly="state not in ('draft', 'submitted')"/>
              <field name="amount_payable" class="oe_subtotal_footer_separator"/>
              <field name="payslip_id" readonly="1"/>
              <field name="payslip_state" invisible="not payslip_id"/>
            </group>
            <group string="Approval" invisible="state == 'draft'">
              <field name="approved_by_id"/>
              <field name="approval_date"/>
            </group>
          </group>
          <group string="Performance Assessment">
            <field name="performance_notes" nolabel="1" readonly="state not in ('draft', 'submitted')"
                   placeholder="Describe the achievements and basis for this award…"/>
          </group>
          <group string="Remarks">
            <field name="remarks" nolabel="1" placeholder="Why this payout differs from the target…"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="variable_pay_view_search" model="ir.ui.view">
    <field name="name">hr.variable.pay.search</field>
    <field name="model">hr.variable.pay</field>
    <field name="arch" type="xml">
      <search string="Variable Pay">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="department_id"/>
        <field name="financial_year"/>
        <field name="payslip_id"/>
        <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
        <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
        <filter name="filter_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
        <separator/>
        <!-- Approved but not yet carried by a payslip: the queue payroll works
             from before running a batch. -->
        <filter name="filter_unpaid" string="Approved, Not Paid"
                domain="[('state', '=', 'approved'), ('payslip_id', '=', False)]"/>
        <separator/>
        <!-- Bare <group>: Odoo 19 search views reject expand/string on it. -->
        <group>
          <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
          <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
          <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                  groups="base.group_multi_company"/>
          <filter name="group_fy" string="Financial Year" context="{'group_by': 'financial_year'}"/>
          <filter name="group_payout_month" string="Payout Month" context="{'group_by': 'payout_date:month'}"/>
          <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="variable_pay_view_pivot" model="ir.ui.view">
    <field name="name">hr.variable.pay.pivot</field>
    <field name="model">hr.variable.pay</field>
    <field name="arch" type="xml">
      <pivot string="Variable Pay Analysis" sample="1">
        <field name="employee_id" type="row"/>
        <field name="payout_date" interval="month" type="col"/>
        <field name="quarterly_target" type="measure"/>
        <field name="amount_payable" type="measure"/>
        <field name="performance_percentage" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="variable_pay_view_graph" model="ir.ui.view">
    <field name="name">hr.variable.pay.graph</field>
    <field name="model">hr.variable.pay</field>
    <field name="arch" type="xml">
      <graph string="Variable Pay" sample="1">
        <field name="payout_date" interval="month"/>
        <field name="amount_payable" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="action_variable_pay" model="ir.actions.act_window">
    <field name="name">Variable Pay</field>
    <field name="res_model">hr.variable.pay</field>
    <field name="view_mode">list,form,pivot,graph</field>
    <field name="search_view_id" ref="variable_pay_view_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Record a performance-based variable pay award</p>
      <p>Choose review start and end dates. The award target is prorated from the employee’s
         annual variable pay. Enter performance percentage and choose a payout date.
         Once approved, the amount reaches the payslip
         whose period contains its payout date.</p>
    </field>
  </record>

  <record id="action_variable_pay_report" model="ir.actions.act_window">
    <field name="name">Variable Pay Analysis</field>
    <field name="res_model">hr.variable.pay</field>
    <field name="view_mode">pivot,graph,list</field>
    <field name="search_view_id" ref="variable_pay_view_search"/>
    <field name="context">{'search_default_group_employee': 1, 'search_default_group_payout_month': 1}</field>
  </record>

  <menuitem id="menu_variable_pay"
            name="Variable Pay"
            parent="hr_payroll.menu_hr_payroll_payslips"
            action="action_variable_pay"
            groups="hr_payroll.group_hr_payroll_user"
            sequence="40"/>

  <menuitem id="menu_variable_pay_report"
            name="Variable Pay"
            parent="hr_payroll.menu_hr_payroll_report"
            action="action_variable_pay_report"
            groups="hr_payroll.group_hr_payroll_user"
            sequence="60"/>
</odoo>
