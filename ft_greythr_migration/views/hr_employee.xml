<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="employee_form_greythr" model="ir.ui.view">
    <field name="name">hr.employee.form.greythr</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="greytHR Migration" groups="hr.group_hr_user">
          <group>
            <field name="greythr_role"/>
            <field name="greythr_father_name"/>
            <field name="greythr_pf_number"/>
            <field name="greythr_pf_join_date"/>
            <field name="greythr_pf_eligible"/>
            <field name="greythr_esi_eligible"/>
            <field name="greythr_applied_ctc_id" groups="hr_payroll.group_hr_payroll_user"/>
          </group>
          <field name="greythr_ctc_ids" groups="hr_payroll.group_hr_payroll_user">
            <list>
              <field name="effective_date"/>
              <field name="employee_status"/>
              <field name="annual_ctc"/>
              <field name="monthly_ctc"/>
              <field name="monthly_gross"/>
            </list>
            <form string="greytHR CTC Source">
              <header>
                <button name="action_apply_to_payroll" type="object" string="Apply to Payroll" groups="hr_payroll.group_hr_payroll_manager" class="btn-primary"/>
              </header>
              <sheet>
                <div class="alert alert-warning" role="alert">Apply this dated CTC to populate salary fields and activate the Fingertip payroll structure. Review reconciliation and statutory deductions before confirming payslips.</div>
                <group string="Payroll Setup">
                  <field name="payroll_pf_mode"/>
                  <field name="gross_difference"/>
                  <field name="payroll_reviewed"/>
                </group>
                <group>
                  <field name="employee_id"/>
                  <field name="effective_date"/>
                  <field name="payout_month"/>
                  <field name="joined_on"/>
                  <field name="leaving_date"/>
                  <field name="employee_status"/>
                  <field name="eligible_for_pf"/>
                  <field name="currency_id" invisible="1"/>
                </group>
                <group string="Source CTC Breakup" col="4">
                  <field name="full_basic"/>
                  <field name="full_hra"/>
                  <field name="full_conveyance"/>
                  <field name="full_special_allowance"/>
                  <field name="full_medical_allowance"/>
                  <field name="full_consultancy_fees"/>
                  <field name="full_employer_esic"/>
                  <field name="full_meal_allowance"/>
                  <field name="full_leave_travel_allowance"/>
                  <field name="full_children_education_allowance"/>
                  <field name="full_attire_allowance"/>
                  <field name="full_book_and_periodicals"/>
                  <field name="full_telephone_charges"/>
                  <field name="full_gratuity"/>
                  <field name="annual_ctc"/>
                  <field name="monthly_ctc"/>
                  <field name="annual_variable_pay"/>
                  <field name="monthly_gross"/>
                  <field name="epf_excess_contribution"/>
                  <field name="pf_base_limit"/>
                  <field name="master_pf_basic"/>
                </group>
                <group>
                  <field name="remarks"/>
                  <field name="review_notes"/>
                </group>
              </sheet>
            </form>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
