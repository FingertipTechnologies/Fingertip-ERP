<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="employee_form_greythr" model="ir.ui.view">
    <field name="name">hr.employee.form.greythr</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='hr_family_group']" position="inside">
        <field name="greythr_father_name" groups="hr.group_hr_user"/>
        <field name="greythr_mother_name" groups="hr.group_hr_user"/>
      </xpath>
      <!-- Smart button, beside the payslip one hr_payroll adds. -->
      <button name="action_open_versions" position="before">
        <button class="oe_stat_button" name="action_open_variable_pay"
                type="object" icon="fa-line-chart"
                groups="hr_payroll.group_hr_payroll_user">
          <field name="ft_variable_pay_count" string="Variable Pay" widget="statinfo"/>
        </button>
      </button>
      <!-- Targets live on hr.version (Odoo 19's contract) and are shown here
           through the _inherits delegation, so editing them writes the active
           version rather than the employee. -->
      <xpath expr="//page[@name='payroll_information']" position="inside">
        <group string="Variable Pay" groups="hr_payroll.group_hr_payroll_user">
          <field name="ft_annual_variable_pay"/>
          <field name="ft_variable_pay_count"/>
        </group>
        <!-- Read-only CTC breakup in the shape of the Fingertip CTC sheet:
             Yearly beside Monthly, with the same subtotals. Derived entirely
             from the salary fields above - nothing here is stored or editable,
             and editing salary stays where it always was. -->
        <group string="Annual CTC Breakup" groups="hr_payroll.group_hr_payroll_user">
          <group string="Yearly">
            <field name="ft_annual_gross" string="Fixed Pay"/>
            <field name="ft_annual_variable_pay" string="Variable Pay" readonly="1"/>
            <field name="ft_annual_pf_employer" string="PF - Employer"/>
            <field name="ft_annual_esic_employer" string="ESI - Employer"/>
            <field name="ft_annual_gratuity" string="Gratuity"/>
            <field name="ft_annual_lwf_employer" string="LWF - Employer"
                   invisible="not ft_annual_lwf_employer"/>
            <field name="ft_annual_ctc" string="Total CTC" class="oe_subtotal_footer_separator"/>
          </group>
          <group string="Monthly">
            <field name="l10n_in_gross_salary" string="Fixed Pay" readonly="1"/>
            <field name="ft_monthly_ctc" string="Total CTC" class="oe_subtotal_footer_separator"/>
          </group>
          <group string="Fixed Salary Break Up (Yearly)">
            <field name="ft_annual_basic" string="Basic Salary"/>
            <field name="ft_annual_hra" string="House Rent Allowance"/>
            <field name="ft_annual_meal" string="Meal Allowance"
                   invisible="not ft_annual_meal"/>
            <field name="ft_annual_children_education" string="Children Education Allowance"
                   invisible="not ft_annual_children_education"/>
            <field name="ft_annual_lta" string="Leave Travel Allowance"
                   invisible="not ft_annual_lta"/>
            <field name="ft_annual_fixed_allowance" string="Special Allowance"/>
            <field name="ft_annual_standard_allowance" string="Standard Allowance"
                   invisible="not ft_annual_standard_allowance"/>
            <field name="ft_annual_performance_bonus" string="Performance Bonus"
                   invisible="not ft_annual_performance_bonus"/>
            <field name="ft_annual_phone" string="Phone Subscription"
                   invisible="not ft_annual_phone"/>
            <field name="ft_annual_internet" string="Internet Subscription"
                   invisible="not ft_annual_internet"/>
            <field name="ft_annual_transport" string="Company Transport"
                   invisible="not ft_annual_transport"/>
            <field name="ft_annual_gross" string="Gross Total"
                   class="oe_subtotal_footer_separator"/>
          </group>
          <group string="Deductions (Yearly)">
            <field name="ft_annual_pf_employee" string="PF - Employee"/>
            <field name="ft_annual_esic_employee" string="ESI - Employee"/>
            <field name="ft_annual_professional_tax" string="Professional Tax"/>
            <field name="ft_annual_medical_insurance" string="Medical Insurance"
                   invisible="not ft_annual_medical_insurance"/>
            <field name="ft_annual_lwf_employee" string="LWF - Employee"
                   invisible="not ft_annual_lwf_employee"/>
            <field name="ft_annual_total_deductions" string="Total Deductions"
                   class="oe_subtotal_footer_separator"/>
            <field name="ft_annual_net_payable" string="Net Payable"/>
            <field name="ft_monthly_net_payable" string="Net Payable (Monthly)"/>
          </group>
        </group>
      </xpath>
      <!-- Odoo has an End of Trial Period date but shows it nowhere. Put it
           beside Contract Type so the confirmation date is visible, and let
           HR edit it to extend or shorten a probation. -->
      <field name="contract_type_id" position="after">
        <field name="trial_date_end" string="Confirmation Date"
               invisible="not trial_date_end"
               help="Date this employee comes off probation. Set automatically to six months after the contract start date, and editable if the probation is extended or shortened. On this date a scheduled action changes the Contract Type to Full-Time."/>
      </field>
      <xpath expr="//notebook" position="inside">
        <page string="greytHR Migration" groups="hr.group_hr_user">
          <group>
            <field name="greythr_role"/>
            <field name="greythr_pf_number"/>
            <field name="greythr_pf_join_date"/>
            <field name="greythr_pf_eligible"/>
            <field name="greythr_esi_eligible"/>
            <field name="greythr_applied_ctc_id" groups="hr_payroll.group_hr_payroll_user"/>
          </group>
          <field name="greythr_ctc_ids" groups="hr_payroll.group_hr_payroll_user">
            <list>
              <field name="effective_date"/>
              <field name="employee_status"/>
              <field name="annual_ctc"/>
              <field name="monthly_ctc"/>
              <field name="monthly_gross"/>
            </list>
            <form string="greytHR CTC Source">
              <header>
                <button name="action_apply_to_payroll" type="object" string="Apply to Payroll" groups="hr_payroll.group_hr_payroll_manager" class="btn-primary"/>
              </header>
              <sheet>
                <div class="alert alert-warning" role="alert">Apply this dated CTC to populate salary fields and activate the Fingertip payroll structure. Review reconciliation and statutory deductions before confirming payslips.</div>
                <group string="Payroll Setup">
                  <field name="payroll_pf_mode"/>
                  <field name="gross_difference"/>
                  <field name="payroll_reviewed"/>
                </group>
                <group>
                  <field name="employee_id"/>
                  <field name="effective_date"/>
                  <field name="payout_month"/>
                  <field name="joined_on"/>
                  <field name="leaving_date"/>
                  <field name="employee_status"/>
                  <field name="eligible_for_pf"/>
                  <field name="currency_id" invisible="1"/>
                </group>
                <group string="Source CTC Breakup" col="4">
                  <field name="full_basic"/>
                  <field name="full_hra"/>
                  <field name="full_conveyance"/>
                  <field name="full_special_allowance"/>
                  <field name="full_medical_allowance"/>
                  <field name="full_consultancy_fees"/>
                  <field name="full_employer_esic"/>
                  <field name="full_meal_allowance"/>
                  <field name="full_leave_travel_allowance"/>
                  <field name="full_children_education_allowance"/>
                  <field name="full_attire_allowance"/>
                  <field name="full_book_and_periodicals"/>
                  <field name="full_telephone_charges"/>
                  <field name="full_gratuity"/>
                  <field name="annual_ctc"/>
                  <field name="monthly_ctc"/>
                  <field name="annual_variable_pay"/>
                  <field name="monthly_gross"/>
                  <field name="epf_excess_contribution"/>
                  <field name="pf_base_limit"/>
                  <field name="master_pf_basic"/>
                </group>
                <group>
                  <field name="remarks"/>
                  <field name="review_notes"/>
                </group>
              </sheet>
            </form>
          </field>
        </page>
      </xpath>
    </field>
  </record>

  <record id="employee_form_in_aadhar" model="ir.ui.view">
    <field name="name">hr.employee.form.in.aadhar</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="l10n_in_hr_payroll.hr_employee_view_form_in_inherit"/>
    <field name="arch" type="xml">
      <field name="l10n_in_uan" position="before">
        <field name="greythr_aadhar_number" placeholder="12 digit Aadhar Number"
               groups="hr.group_hr_user"/>
      </field>
    </field>
  </record>

  <!-- The meal amount is paid as an earning (MEAL rule), so list it with the salary
       components instead of under Benefits. Same field, so computation is unchanged. -->
  <record id="employee_form_in_children_education" model="ir.ui.view">
    <field name="name">hr.employee.form.in.children.education</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="l10n_in_hr_payroll.hr_employee_view_form_in_inherit"/>
    <field name="arch" type="xml">
      <separator name="benefits" position="before">
        <label for="ft_children_education_allowance"/>
        <div class="o_row">
          <field name="ft_children_education_allowance" class="o_hr_narrow_field"/>
          <span>/ month</span>
        </div>
      </separator>
    </field>
  </record>

  <record id="contract_template_form_in_children_education" model="ir.ui.view">
    <field name="name">hr.contract.template.form.in.children.education</field>
    <field name="model">hr.version</field>
    <field name="inherit_id" ref="l10n_in_hr_payroll.hr_contract_template_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='l10n_in_meal_voucher_amount']/.." position="after">
        <label for="ft_children_education_allowance"/>
        <div class="o_row">
          <field name="ft_children_education_allowance" class="o_hr_narrow_field"/>
          <span>/ month</span>
        </div>
      </xpath>
    </field>
  </record>

  <record id="employee_form_in_meal_allowance" model="ir.ui.view">
    <field name="name">hr.employee.form.in.meal.allowance</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="l10n_in_hr_payroll.hr_employee_view_form_in_inherit"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='l10n_in_fixed_allowance']/.." position="after">
        <xpath expr="//label[@for='l10n_in_meal_voucher_amount']" position="move"/>
        <xpath expr="//field[@name='l10n_in_meal_voucher_amount']/.." position="move"/>
      </xpath>
      <xpath expr="//label[@for='l10n_in_meal_voucher_amount']" position="attributes">
        <attribute name="string">Meal Allowance</attribute>
      </xpath>
      <field name="l10n_in_meal_voucher_amount" position="attributes">
        <attribute name="string">Meal Allowance</attribute>
      </field>
    </field>
  </record>

  <record id="contract_template_form_in_meal_allowance" model="ir.ui.view">
    <field name="name">hr.contract.template.form.in.meal.allowance</field>
    <field name="model">hr.version</field>
    <field name="inherit_id" ref="l10n_in_hr_payroll.hr_contract_template_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='l10n_in_fixed_allowance']/.." position="after">
        <xpath expr="//label[@for='l10n_in_meal_voucher_amount']" position="move"/>
        <xpath expr="//field[@name='l10n_in_meal_voucher_amount']/.." position="move"/>
      </xpath>
      <xpath expr="//label[@for='l10n_in_meal_voucher_amount']" position="attributes">
        <attribute name="string">Meal Allowance</attribute>
      </xpath>
      <field name="l10n_in_meal_voucher_amount" position="attributes">
        <attribute name="string">Meal Allowance</attribute>
      </field>
    </field>
  </record>
</odoo>
