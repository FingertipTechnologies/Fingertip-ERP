<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pay run card: post every payslip's journal entry in one click, after
         Validate and before paying. -->
    <record id="hr_payslip_run_view_kanban_post_entries" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban.post.entries</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="ft_draft_move_count"/>
            </field>
            <button name="action_paid" position="before">
                <button name="action_ft_post_entries" type="object" class="btn oe_highlight"
                        string="Post Journal Entries" groups="account.group_account_invoice"
                        invisible="state != '02_close' or not ft_draft_move_count"
                        options="{'is_priority': True}"/>
            </button>
        </field>
    </record>
</odoo>
