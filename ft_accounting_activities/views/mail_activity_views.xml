<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_view_list_accounting" model="ir.ui.view">
        <field name="name">mail.activity.view.list.accounting</field>
        <field name="model">mail.activity</field>
        <field name="priority">40</field>
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list string="Activity Log" default_order="ft_activity_date desc, id desc"
                  js_class="archive_disabled_activity_list"
                  decoration-muted="not active">
                <field name="active" column_invisible="1"/>
                <field name="ft_activity_date"/>
                <field name="ft_partner_id"/>
                <field name="res_name" string="Document"/>
                <field name="ft_document_type" optional="show"/>
                <field name="activity_type_id"/>
                <field name="summary" optional="show"/>
                <field name="note" string="Description" optional="show"/>
                <field name="feedback" string="Remark"/>
                <field name="user_id" string="Assigned To" widget="many2one_avatar_user"/>
                <field name="date_deadline" string="Due Date" optional="hide"/>
                <field name="date_done" optional="hide"/>
                <field name="create_uid" string="Created By" widget="many2one_avatar_user" optional="hide"/>
                <field name="state" widget="badge" optional="show"
                       decoration-danger="state == 'overdue'"
                       decoration-warning="state == 'today'"
                       decoration-info="state == 'planned'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Opened from a log line or New; done activities are archived and read-only -->
    <record id="mail_activity_view_form_accounting" model="ir.ui.view">
        <field name="name">mail.activity.view.form.accounting</field>
        <field name="model">mail.activity</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <form string="Activity" duplicate="0">
                <header>
                    <button name="action_open_document" type="object" string="Open Document"
                            class="btn-secondary" invisible="not id"/>
                    <field name="state" widget="badge" invisible="not id"
                           decoration-danger="state == 'overdue'"
                           decoration-warning="state == 'today'"
                           decoration-info="state == 'planned'"
                           decoration-success="state == 'done'"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="summary" placeholder="e.g. Payment follow-up"
                                   readonly="not active"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="res_model_id" invisible="1"/>
                            <field name="ft_res_model" readonly="id" required="not id"
                                   placeholder="Sales Order, Invoice, Payment or Customer"/>
                            <field name="ft_res_id" widget="many2one_reference" readonly="id"
                                   required="not id" placeholder="Pick the document"
                                   options="{'no_create': True}"/>
                            <field name="ft_partner_id"/>
                            <field name="ft_document_type"/>
                            <field name="activity_type_id" required="1" readonly="not active"
                                   domain="[('res_model', 'in', [False, 'sale.order', 'account.move', 'account.payment', 'res.partner'])]"/>
                        </group>
                        <group>
                            <field name="date_deadline" string="Due Date" readonly="not active"/>
                            <field name="date_done" invisible="active"/>
                            <field name="user_id" string="Assigned To" widget="many2one_avatar_user"
                                   readonly="not active"/>
                            <field name="create_uid" string="Created By" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="note" class="oe-bordered-editor" readonly="not active"
                           options="{'embedded_components': false}"/>
                    <separator string="Remark" invisible="active"/>
                    <field name="feedback" invisible="active" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_activity_view_search_accounting" model="ir.ui.view">
        <field name="name">mail.activity.view.search.accounting</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="res_name" position="after">
                <field name="ft_partner_id"/>
                <field name="feedback" string="Remark"/>
            </field>
            <filter name="filter_user_id_uid" position="before">
                <filter name="filter_log_today" string="Today"
                        domain="[('ft_activity_date', '=', 'today')]"/>
                <filter name="filter_log_week" string="This Week"
                        domain="[('ft_activity_date', '&gt;=', '=week_start'),
                                 ('ft_activity_date', '&lt;', '=week_start +1w')]"/>
                <separator/>
                <filter name="filter_pending" string="Pending" domain="[('active', '=', True)]"/>
                <filter name="filter_done_log" string="Done" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_sale_order" string="Sales Orders / Pro forma"
                        domain="[('ft_document_type', '=', 'sale_order')]"/>
                <filter name="filter_customer_invoice" string="Invoices / Credit Notes"
                        domain="[('ft_document_type', '=', 'customer_invoice')]"/>
                <filter name="filter_vendor_bill" string="Vendor Bills"
                        domain="[('ft_document_type', '=', 'vendor_bill')]"/>
                <filter name="filter_journal_entry" string="Journal Entries"
                        domain="[('ft_document_type', '=', 'journal_entry')]"/>
                <filter name="filter_payment" string="Payments"
                        domain="[('ft_document_type', '=', 'payment')]"/>
                <filter name="filter_partner" string="Customers / Contacts"
                        domain="[('ft_document_type', '=', 'partner')]"/>
                <separator/>
            </filter>
            <!-- the core Done filter is replaced by filter_done_log above -->
            <filter name="filter_archived" position="replace"/>
            <filter name="date_deadline" position="before">
                <filter string="Customer" name="group_by_partner" context="{'group_by': 'ft_partner_id'}"/>
                <filter string="Date: Day" name="group_by_log_day" context="{'group_by': 'ft_activity_date:day'}"/>
                <filter string="Date: Week" name="group_by_log_week" context="{'group_by': 'ft_activity_date:week'}"/>
            </filter>
        </field>
    </record>

    <record id="mail_activity_view_pivot_accounting" model="ir.ui.view">
        <field name="name">mail.activity.view.pivot.accounting</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <pivot string="Activities" sample="1">
                <field name="ft_partner_id" type="row"/>
                <field name="activity_type_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_accounting_activities" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban,calendar,pivot,form</field>
        <field name="domain">[('res_model', 'in', ['sale.order', 'account.move', 'account.payment', 'res.partner'])]</field>
        <field name="search_view_id" ref="mail_activity_view_search_accounting"/>
        <field name="context">{'force_search_count': 1, 'active_test': False, 'search_default_filter_log_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activities in this period</p>
            <p>Activities scheduled from the chatter of Sales Orders, Invoices, Payments and Customers appear here,
               with the remark entered when they are marked done.</p>
        </field>
    </record>

    <record id="action_accounting_activities_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail_activity_view_list_accounting"/>
        <field name="act_window_id" ref="action_accounting_activities"/>
    </record>
    <record id="action_accounting_activities_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="mail.mail_activity_view_kanban_open_target"/>
        <field name="act_window_id" ref="action_accounting_activities"/>
    </record>
    <record id="action_accounting_activities_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="mail.mail_activity_view_calendar"/>
        <field name="act_window_id" ref="action_accounting_activities"/>
    </record>
    <record id="action_accounting_activities_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="mail_activity_view_pivot_accounting"/>
        <field name="act_window_id" ref="action_accounting_activities"/>
    </record>
    <record id="action_accounting_activities_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mail_activity_view_form_accounting"/>
        <field name="act_window_id" ref="action_accounting_activities"/>
    </record>

    <!-- Sales top menu: To Invoice is sequence 20 and Products 30. Menu groups
         are only added on upgrade, so the former Accounting groups are removed
         explicitly -->
    <menuitem id="menu_accounting_activities"
              name="Activities"
              parent="sale.sale_menu_root"
              action="action_accounting_activities"
              groups="sales_team.group_sale_salesman,-account.group_account_invoice,-account.group_account_readonly"
              sequence="25"/>
</odoo>
