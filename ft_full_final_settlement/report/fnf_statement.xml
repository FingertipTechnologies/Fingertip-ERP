<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_fnf_statement" model="ir.actions.report">
        <field name="name">Full &amp; Final Statement</field>
        <field name="model">ft.fnf.settlement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ft_full_final_settlement.report_fnf_statement</field>
        <field name="report_file">ft_full_final_settlement.report_fnf_statement</field>
        <field name="print_report_name">'Full and Final Statement - %s' % object.employee_id.name</field>
        <field name="binding_model_id" ref="model_ft_fnf_settlement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fnf_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="cur" t-value="o.currency_id"/>
                    <div class="page">
                        <h3 class="text-center mb-1">Full &amp; Final Settlement Statement</h3>
                        <p class="text-center text-muted mb-4"><span t-field="o.name"/></p>
                        <table class="table table-sm table-borderless mb-4">
                            <tr>
                                <td><strong>Employee</strong></td><td><span t-field="o.employee_id.name"/></td>
                                <td><strong>Employee Code</strong></td><td><span t-out="o.employee_id.registration_number or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Designation</strong></td><td><span t-out="o.employee_id.job_id.name or ''"/></td>
                                <td><strong>Department</strong></td><td><span t-out="o.employee_id.department_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Date of Joining</strong></td><td><span t-field="o.joining_date"/></td>
                                <td><strong>Resignation Date</strong></td><td><span t-field="o.resignation_date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Last Working Day</strong></td><td><span t-field="o.last_working_date"/></td>
                                <td><strong>Service</strong></td><td><span t-field="o.service_text"/></td>
                            </tr>
                            <tr>
                                <td><strong>Monthly Gross</strong></td><td><span t-field="o.monthly_gross"/></td>
                                <td><strong>Monthly Basic</strong></td><td><span t-field="o.monthly_basic"/></td>
                            </tr>
                        </table>

                        <div class="row">
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>Due to the Employee</th><th class="text-end">Amount</th></tr></thead>
                                    <tbody>
                                        <tr>
                                            <td>Leave Encashment
                                                <div class="text-muted small"><span t-out="'%g' % o.encash_days"/> days × <span t-field="o.encash_rate"/></div></td>
                                            <td class="text-end"><span t-field="o.encash_amount"/></td>
                                        </tr>
                                        <tr>
                                            <td>Gratuity<div class="text-muted small" t-if="o.gratuity_note"><span t-field="o.gratuity_note"/></div></td>
                                            <td class="text-end"><span t-field="o.gratuity_amount"/></td>
                                        </tr>
                                        <tr t-if="o.variable_pay_due">
                                            <td>Variable Pay / Bonus Due</td>
                                            <td class="text-end"><span t-field="o.variable_pay_due"/></td>
                                        </tr>
                                        <tr t-if="o.other_dues">
                                            <td>Other Dues<div class="text-muted small" t-if="o.other_dues_note"><span t-field="o.other_dues_note"/></div></td>
                                            <td class="text-end"><span t-field="o.other_dues"/></td>
                                        </tr>
                                        <tr class="fw-bold"><td>Total Dues</td><td class="text-end"><span t-field="o.total_dues"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>Recovered from the Employee</th><th class="text-end">Amount</th></tr></thead>
                                    <tbody>
                                        <tr>
                                            <td>Notice Period Recovery
                                                <div class="text-muted small"><span t-out="o.notice_served"/> of <span t-out="o.notice_days"/> days served;
                                                    <span t-out="o.notice_shortfall"/> days × <span t-field="o.notice_rate"/></div></td>
                                            <td class="text-end"><span t-field="o.notice_recovery"/></td>
                                        </tr>
                                        <tr t-if="o.advance_recovery">
                                            <td>Salary Advance Balance</td>
                                            <td class="text-end"><span t-field="o.advance_recovery"/></td>
                                        </tr>
                                        <tr t-if="o.other_recoveries">
                                            <td>Other Recoveries<div class="text-muted small" t-if="o.other_recoveries_note"><span t-field="o.other_recoveries_note"/></div></td>
                                            <td class="text-end"><span t-field="o.other_recoveries"/></td>
                                        </tr>
                                        <tr t-if="o.tds_amount">
                                            <td>Tax Deducted at Source</td>
                                            <td class="text-end"><span t-field="o.tds_amount"/></td>
                                        </tr>
                                        <tr class="fw-bold"><td>Total Recoveries</td><td class="text-end"><span t-field="o.total_recoveries"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-2">
                            <tr class="fw-bold fs-5">
                                <td t-if="o.net_amount &gt;= 0">Net Amount Payable to the Employee</td>
                                <td t-else="">Net Amount Recoverable from the Employee</td>
                                <td class="text-end"><span t-out="abs(o.net_amount)" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                            </tr>
                        </table>
                        <p class="small text-muted" t-if="o.final_payslip_id">
                            The salary for the last month is paid on payslip <span t-out="o.final_payslip_id.name"/>
                            (net <span t-field="o.final_payslip_id.net_wage"/>), released together with this settlement.
                        </p>
                        <p t-if="o.notes" class="mt-3"><span t-field="o.notes"/></p>

                        <p class="mt-5">I acknowledge receipt of the above amount in full and final settlement of all my dues
                            from <span t-field="o.company_id.name"/>, and have no further claim against the company.</p>
                        <div class="row mt-5 pt-4">
                            <div class="col-4 text-center"><div class="border-top pt-1">Prepared by (HR)</div></div>
                            <div class="col-4 text-center"><div class="border-top pt-1">Approved by</div></div>
                            <div class="col-4 text-center"><div class="border-top pt-1">Employee Signature &amp; Date</div></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
